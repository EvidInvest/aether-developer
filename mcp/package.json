{
  "name": "@evidinvest/aether-mcp",
  "version": "0.2.0",
  "description": "Aether MCP — stdio MCP server that wraps the Aether HTTP API (https://api.aether.evidinvest.com/mcp). Lets Claude Desktop, Cursor, Cline, and any stdio-MCP client use Aether's hybrid SEC + transcript search + marketplace tools with a single `npx` install.",
  "keywords": [
    "mcp",
    "claude",
    "claude-desktop",
    "cursor",
    "cline",
    "aether",
    "sec-filings",
    "earnings-transcripts",
    "financial-research",
    "marketplace"
  ],
  "author": "EvidInvest / EBD-Sweden",
  "license": "Apache-2.0",
  "homepage": "https://github.com/EvidInvest/aether-developer/tree/main/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvidInvest/aether-developer.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/EvidInvest/aether-developer/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aether-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
